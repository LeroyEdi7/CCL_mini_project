NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTH_WEB_ORIGIN=http://localhost:5173
AUTH_APP_BASE_URL=http://localhost:5173
AUTH_SESSION_TTL_SECONDS=604800
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
# Set true only for local development to print email links to the API console.
DEV_EMAIL_ENABLED=false
# Optional S3-compatible private certificate storage. For Neon Object Storage,
# use the endpoint, region, and credentials from Neon plus the provisioned bucket name.
# AWS SDK reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the environment.
# AWS_REGION=us-east-2
# AWS_ENDPOINT_URL_S3=https://<your-neon-object-storage-endpoint>
# CERTIFICATE_S3_BUCKET=your-private-certificate-bucket
# Production AWS S3 workloads should use an attached IAM role rather than access keys.
CERTIFICATE_PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify
# Optional database-backed integration tests. Point only at a disposable,
# migrated PostgreSQL database; never reuse DATABASE_URL.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ISOLATED_TEST_DATABASE?sslmode=require
# TEST_DATABASE_ISOLATED=true
